{
  "name": "open-subdomains",
  "version": "3.0.0",
  "private": true,
  "description": "Free-subdomain registry behind is-a.ceo. One JSON file per claim in domains/, policy in registry/, and DNSControl reads both at push time.",
  "scripts": {
    "check": "node scripts/validate.js",
    "template": "node scripts/template.js",
    "test": "node --test \"test/**/*.test.js\"",
    "verify": "npm run check && npm test",
    "report": "node scripts/report.js",
    "status": "node scripts/status.js",
    "zones": "node scripts/status.js --zones",
    "proof": "node scripts/proof.js",
    "audit": "node scripts/audit.js"
  },
  "engines": {
    "node": ">=20"
  }
}
